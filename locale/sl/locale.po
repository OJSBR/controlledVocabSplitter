#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.displayName"
msgstr "Delilnik nadzorovanih slovarjev"


#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.description"
msgstr "Avtorji pogosto označijo vrstico s ključnimi besedami v rokopisu, jo kopirajo in v celoti prilepijo v polje, zato se shrani en sam dolg izraz namesto več. Spodaj izberite, kateri slovarji se delijo in katera ločila se upoštevajo."

