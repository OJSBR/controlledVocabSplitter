#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.displayName"
msgstr "Dělič řízených slovníků"


#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.description"
msgstr "Autoři často označí řádek s klíčovými slovy v rukopisu, zkopírují jej a celý vloží do pole, takže se uloží jeden dlouhý termín místo několika. Níže zvolte, které slovníky se dělí a které oddělovače se respektují."

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.fields.title"
msgstr "Slovníky"

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.fields.hint"
msgstr "Upravují se pouze zde zaškrtnuté slovníky. Vše ostatní se uloží přesně tak, jak bylo napsáno."

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.separators.title"
msgstr "Oddělovače"

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.separators.hint"
msgstr "Na každý záznam se použije jen jeden oddělovač: první z níže uvedených, který se v něm vyskytne. Seznam napsaný se středníky a čárkami se proto dělí jen na střednících."

