msgid "plugins.generic.controlledVocabSplitter.displayName"
msgstr "Razdvajač kontrolisanih rečnika"

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.description"
msgstr "Deli ključne reči, teme, discipline i institucije podrške nalepljene kao jedan red na pojedinačne termine koje je autor imao u vidu — u samom polju i pri svakom čuvanju."

