#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.displayName"
msgstr "جداکنندهٔ واژگان کنترل‌شده"

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.description"
msgstr "کلیدواژه‌ها، موضوع‌ها، رشته‌ها و نهادهای پشتیبان را که به‌صورت یک سطر چسبانده شده‌اند به همان اصطلاح‌های جدا که نویسنده در نظر داشته تفکیک می‌کند — در خود فیلد و در هر بار ذخیره."

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.description"
msgstr "نویسندگان اغلب سطر کلیدواژه‌های دست‌نوشتهٔ خود را انتخاب و کپی می‌کنند و همه را یک‌جا در فیلد می‌چسبانند؛ در نتیجه به‌جای چند اصطلاح، یک اصطلاح بلند ذخیره می‌شود. در ادامه انتخاب کنید کدام واژگان تفکیک شوند و کدام جداکننده‌ها معتبر باشند."

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.fields.title"
msgstr "واژگان"

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.fields.hint"
msgstr "تنها واژگان تیک‌خورده در اینجا دستکاری می‌شوند. باقی موارد دقیقاً همان‌گونه که تایپ شده ذخیره می‌شود."

#, fuzzy
