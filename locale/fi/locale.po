#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.displayName"
msgstr "Kontrolloitujen sanastojen jakaja"


#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.description"
msgstr "Kirjoittajat maalaavat usein käsikirjoituksensa avainsanarivin, kopioivat sen ja liittävät koko rivin kenttään, jolloin tallentuu yksi pitkä termi useiden sijaan. Valitse alta, mitkä sanastot jaetaan ja mitkä erottimet otetaan huomioon."

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.fields.title"
msgstr "Sanastot"

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.fields.hint"
msgstr "Vain tässä valitut sanastot käsitellään. Kaikki muu tallennetaan täsmälleen sellaisena kuin se on kirjoitettu."

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.separators.title"
msgstr "Erottimet"

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.separators.hint"
msgstr "Kutakin merkintää kohden käytetään vain yhtä erotinta: ensimmäistä alla olevista, joka siinä esiintyy. Puolipistein ja pilkuin kirjoitettu luettelo katkaistaan siis vain puolipisteiden kohdalta."

