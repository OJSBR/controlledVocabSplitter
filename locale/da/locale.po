#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.displayName"
msgstr "Opdeler af kontrollerede vokabularer"


#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.description"
msgstr "Forfattere markerer ofte nøgleordslinjen i manuskriptet, kopierer den og indsætter det hele i feltet, så der gemmes én lang term i stedet for flere. Vælg nedenfor, hvilke vokabularer der opdeles, og hvilke adskillere der respekteres."

#, fuzzy
