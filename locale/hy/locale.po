#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.safety.body"
msgstr "Կետը բաժանում է միայն այն դեպքում, երբ դրան հաջորդում է բացատ, ինչը ամբողջական է պահում իրավական հղումները, ինչպիսին է «Lei 13.964/2019», և երբեք՝ մեկ տառից հետո, ինչը ամբողջական է պահում «S. aureus»-ը և «E. coli»-ն։"

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.hint"
msgstr "Արդեն պահված գրառումները մնում են անփոփոխ, մինչև նորից չպահվեն։ Առկա արխիվը մեկ անցումով ուղղելու համար գործարկեք այս հավելման հետ եկող tools/fixExistingVocabs.php սկրիպտը. այն փորձնական գործարկում է, եթե գրելը հատուկ չպահանջեք։"

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.description"
msgstr "Մեկ տողում տեղադրված բանալի բառերը, թեմաները, առարկաները և աջակցող կազմակերպությունները բաժանում է հեղինակի նկատի ունեցած առանձին տերմինների՝ հրապարակումը պահպանելիս կամ ներմուտքագրելիս։"
