#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.displayName"
msgstr "Delare av kontrollerade vokabulärer"

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.description"
msgstr "Delar nyckelord, ämnen, discipliner och stödjande organisationer som klistrats in som en enda rad i de separata termer som författaren avsåg – i själva fältet och vid varje sparning."

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.description"
msgstr "Författare markerar ofta nyckelordsraden i sitt manus, kopierar den och klistrar in hela raden i fältet, vilket lagrar en enda lång term i stället för flera. Välj nedan vilka vokabulärer som delas och vilka avgränsare som gäller."

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.fields.title"
msgstr "Vokabulärer"

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.fields.hint"
msgstr "Endast de vokabulärer som är markerade här påverkas. Allt annat sparas exakt som det skrevs."

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.separators.title"
msgstr "Avgränsare"

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.separators.hint"
msgstr "Endast en avgränsare används per post: den första av nedanstående som förekommer i den. En lista skriven med semikolon och kommatecken delas därför bara vid semikolonen."

