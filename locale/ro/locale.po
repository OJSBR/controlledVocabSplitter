#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.displayName"
msgstr "Separator de vocabulare controlate"

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.description"
msgstr "Împarte cuvintele-cheie, subiectele, disciplinele și agențiile de sprijin lipite ca o singură linie în termenii separați pe care autorul i-a avut în vedere — chiar în câmp și la fiecare salvare."

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.description"
msgstr "Autorii selectează adesea linia cu cuvinte-cheie din manuscris, o copiază și o lipesc integral în câmp, astfel încât se stochează un singur termen lung în loc de mai mulți. Alegeți mai jos ce vocabulare se împart și ce separatori sunt respectați."

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.fields.title"
msgstr "Vocabulare"

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.fields.hint"
msgstr "Sunt afectate doar vocabularele bifate aici. Tot restul se stochează exact așa cum a fost tastat."

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.separators.title"
msgstr "Separatori"

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.separators.hint"
msgstr "Se folosește un singur separator per intrare: primul dintre cele de mai jos care apare în ea. Astfel, o listă scrisă cu punct și virgulă și cu virgule este tăiată doar la punct și virgulă."

#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.column.vocabulary"
msgstr "Vocabular"

#, fuzzy
