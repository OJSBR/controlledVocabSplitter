#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.displayName"
msgstr "Bộ tách từ vựng có kiểm soát"


#, fuzzy
msgid "plugins.generic.controlledVocabSplitter.settings.description"
msgstr "Tác giả thường bôi đen dòng từ khóa trong bản thảo, sao chép và dán nguyên vào ô, khiến hệ thống lưu một cụm dài thay vì nhiều từ khóa. Hãy chọn bên dưới những bộ từ vựng nào được tách và những dấu phân tách nào được áp dụng."

#, fuzzy
